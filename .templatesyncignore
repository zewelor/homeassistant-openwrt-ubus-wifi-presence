# Template Sync Ignore File
# ============================================================
# Files and folders listed here will NOT be synced from the
# upstream template (jpawlowski/hacs.integration_blueprint).
#
# Syntax follows .gitignore glob patterns.
# See: https://github.com/AndreasAugustin/actions-template-sync
# ============================================================

# ── Integration source and tests ──────────────────────────────
# These paths contain project-specific runtime code, domain names, and fixtures.
custom_components/
tests/

# ── Project configuration ─────────────────────────────────────
# These files contain project-specific domain and validation configuration.
pyproject.toml
.yamllint.yml
.pre-commit-config.yaml

# ── Ignore pattern files ───────────────────────────────────────
# These contain project-specific paths and negations.
.gitignore
.prettierignore

# ── Runtime dependencies ──────────────────────────────────────
# requirements.txt mirrors this integration's manifest requirements.
requirements.txt

# ── VS Code workspace settings ───────────────────────────────
# These reference the integration domain and local commands.
.vscode/launch.json
.vscode/tasks.json

# ── Project-owned files ───────────────────────────────────────
README.md
LICENSE
hacs.json
CONTRIBUTING.md
DEPENDENCIES.md

# The one-time template initializer was removed after project initialization.
# Keep ignoring it so a future template sync cannot add it back.
initialize.sh
README.template.md

# ── AI agent instruction files ───────────────────────────────
# Keep the project-specific instruction set and prevent duplicate blueprint.*
# copies from being reintroduced alongside the maintained files.
AGENTS.md
CLAUDE.md
GEMINI.md
.github/copilot-instructions.md
.github/instructions/blueprint.*.instructions.md

# ── GitHub project settings ──────────────────────────────────
.github/CODEOWNERS
.github/FUNDING.yml
.github/COPILOT_CODING_AGENT.md

# ── Script and DevContainer hooks ────────────────────────────
script/hooks/
.devcontainer/hooks/

# post-attach.sh is project-owned and no longer contains template initialization.
.devcontainer/post-attach.sh

# ── DevContainer environment overrides ───────────────────────
.devcontainer/.env

# ── Release management ───────────────────────────────────────
release-please-config.json
.release-please-manifest.json

# ── Local Home Assistant development config ─────────────────
config/

# ── Documentation ────────────────────────────────────────────
docs/

# ── Template sync control ────────────────────────────────────
.templatesyncignore
.github/workflows/template-sync.yml

# ── Lockfiles ────────────────────────────────────────────────
uv.lock

# ── GitHub Issue Templates ───────────────────────────────────
.github/ISSUE_TEMPLATE/
