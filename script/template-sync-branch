#!/bin/bash

# Update a single template-sync PR without rewriting its existing commits.
# Usage: script/template-sync-branch prepare | publish <source-sha>

set -euo pipefail

branch="chore/blueprint-sync"
base_branch="main"
repo="${GITHUB_REPOSITORY:?GITHUB_REPOSITORY is required}"
base_sha="${TEMPLATE_SYNC_BASE_SHA:?TEMPLATE_SYNC_BASE_SHA is required}"
[[ -n "${GH_TOKEN:-}" ]] || {
    echo "GH_TOKEN is required" >&2
    exit 1
}

git_with_auth() {
    git -c credential.helper= -c 'credential.helper=!gh auth git-credential' "$@"
}

remote_sha() {
    local result
    if ! result="$(git_with_auth ls-remote --heads origin "refs/heads/$1")"; then
        echo "Could not read remote branch $1" >&2
        return 1
    fi
    printf '%s' "${result%%[[:space:]]*}"
}

open_prs() {
    gh pr list --repo "$repo" --head "$branch" --base "$base_branch" --state open \
        --json number,headRepository,headRefOid --limit 100
}

open_pr_count() {
    open_prs | jq --arg repo "$repo" '[.[] | select(.headRepository.nameWithOwner == $repo)] | length'
}

latest_pr_was_merged() {
    local expected_sha="$1"
    gh pr list --repo "$repo" --head "$branch" --base "$base_branch" --state all \
        --json number,state,headRepository,headRefOid --limit 100 |
        jq -r --arg repo "$repo" --arg sha "$expected_sha" '
            [.[] | select(.headRepository.nameWithOwner == $repo)] | sort_by(.number) |
            if length > 0 then (.[-1].state == "MERGED" and .[-1].headRefOid == $sha) else false end
        '
}

case "${1:-}" in
prepare)
    [[ $# -eq 1 ]] || {
        echo "Usage: template-sync-branch prepare" >&2
        exit 2
    }
    [[ -z "$(git status --porcelain=v1 --untracked-files=all)" ]] || {
        echo "Template sync requires a clean disposable checkout" >&2
        exit 1
    }
    [[ "$(git rev-parse HEAD)" == "$base_sha" ]] || {
        echo "Checkout is not the expected base" >&2
        exit 1
    }
    [[ "$(remote_sha "$base_branch")" == "$base_sha" ]] || {
        echo "The base branch moved; retry from its current revision" >&2
        exit 1
    }
    git config user.name 'github-actions[bot]'
    git config user.email '41898282+github-actions[bot]@users.noreply.github.com'

    previous_sha="$(remote_sha "$branch")"
    pr_count="$(open_pr_count)"
    if [[ -n "$previous_sha" ]]; then
        if [[ "$pr_count" != 1 ]] &&
            ! { [[ "$pr_count" == 0 ]] && [[ "$(latest_pr_was_merged "$previous_sha")" == true ]]; }; then
            echo "The sync branch has no open or matching merged PR; inspect it before updating" >&2
            exit 1
        fi
        git_with_auth fetch --no-tags origin "refs/heads/$branch"
        [[ "$(git rev-parse FETCH_HEAD)" == "$previous_sha" ]] || {
            echo "The sync branch changed while fetching; retry" >&2
            exit 1
        }
        git switch -c "$branch" FETCH_HEAD
        git merge --no-edit "$base_sha"
    else
        [[ "$pr_count" == 0 ]] || {
            echo "An open sync PR exists but its branch is missing" >&2
            exit 1
        }
        git switch -c "$branch"
    fi
    ;;
publish)
    [[ $# -eq 2 && "$2" =~ ^[0-9a-f]{40}$ ]] || {
        echo "Usage: template-sync-branch publish <source-sha>" >&2
        exit 2
    }
    [[ "$(git branch --show-current)" == "$branch" ]] || {
        echo "Not on the sync branch" >&2
        exit 1
    }
    git diff --quiet || {
        echo "Unstaged changes remain after sync" >&2
        exit 1
    }
    [[ -z "$(git ls-files --others --exclude-standard)" ]] || {
        echo "Untracked files remain after sync" >&2
        exit 1
    }
    if ! git diff --cached --quiet; then
        git commit -m 'chore(template): sync blueprint updates' -m "Template-Sync-Source: $2"
    fi

    previous_sha="$(remote_sha "$branch")"
    pr_count="$(open_pr_count)"
    if [[ -n "$previous_sha" && "$pr_count" != 1 ]] &&
        ! { [[ "$pr_count" == 0 ]] && [[ "$(latest_pr_was_merged "$previous_sha")" == true ]]; }; then
        echo "Sync branch and open PR no longer agree; inspect before publishing" >&2
        exit 1
    fi
    if [[ -z "$previous_sha" && "$pr_count" != 0 ]]; then
        echo "Sync branch and open PR no longer agree; inspect before publishing" >&2
        exit 1
    fi
    if [[ "$pr_count" == 0 ]] && git diff --quiet "$base_sha" HEAD; then
        echo "The template has no changes to propose"
        exit 0
    fi
    [[ "$(remote_sha "$base_branch")" == "$base_sha" ]] || {
        echo "The base branch moved; retry from its current revision" >&2
        exit 1
    }
    if [[ "$(git rev-parse HEAD)" != "$previous_sha" ]]; then
        git_with_auth push origin "HEAD:refs/heads/$branch"
    fi
    if [[ "$pr_count" == 0 ]]; then
        gh pr create --repo "$repo" --base "$base_branch" --head "$branch" \
            --title 'chore: sync updates from integration blueprint template' \
            --body "Blueprint revision: https://github.com/jpawlowski/hacs.integration_blueprint/commit/$2" \
            --label template-sync
    fi

    expected_sha="$(git rev-parse HEAD)"
    verified=false
    for attempt in 1 2 3 4 5; do
        pr_sha="$(open_prs | jq -r --arg repo "$repo" '
            [.[] | select(.headRepository.nameWithOwner == $repo)] |
            if length == 1 then .[0].headRefOid else "" end
        ')"
        if [[ "$pr_sha" == "$expected_sha" ]]; then
            verified=true
            break
        fi
        [[ "$attempt" == 5 ]] || sleep 2
    done
    [[ "$verified" == true ]] || {
        echo "The open sync PR does not point to the published commit; inspect its state" >&2
        exit 1
    }
    ;;
*)
    echo "Usage: template-sync-branch prepare | publish <source-sha>" >&2
    exit 2
    ;;
esac
